{
  "defaults": {
    "h1": "issue-cover",
    "h2": "index-rule",
    "h3": "marker-stroke",
    "quote": "centered-quote",
    "strong": "accent",
    "ordered-list": "leading-zero",
    "unordered-list": "soft-check",
    "table": "minimal-lines"
  },
  "themes": [
    {
      "id": "editorial-blue",
      "label": "航·编辑蓝",
      "description": "墨色正文、钴蓝信号与暖橙转折。",
      "tokens": { "accent": "#2447D8", "warm": "#E98A3A", "ink": "#101827", "body": "#263246", "paper": "#F7F2E8", "pale": "#EEF2FF", "border": "#D9E0EA" }
    },
    {
      "id": "cloud-blue",
      "label": "航·云蓝留白",
      "description": "浅云蓝、冷白纸面与低对比边界。",
      "tokens": { "accent": "#2F6BFF", "warm": "#F0A64A", "ink": "#12213A", "body": "#34445F", "paper": "#F3F7FF", "pale": "#E9F1FF", "border": "#CAD8EE" }
    },
    {
      "id": "ink-archive",
      "label": "航·纸墨档案",
      "description": "石墨、档案纸与克制的红色校记。",
      "tokens": { "accent": "#3E4654", "warm": "#C75C4A", "ink": "#17191E", "body": "#363A43", "paper": "#F2F0EA", "pale": "#ECEDEF", "border": "#C8CBD0" }
    },
    {
      "id": "warm-journal",
      "label": "航·暖橙手记",
      "description": "暖纸、橙黄信号与手记式章节节奏。",
      "tokens": { "accent": "#D87521", "warm": "#F2B544", "ink": "#2B211B", "body": "#493B31", "paper": "#FFF6E8", "pale": "#FFF0D9", "border": "#E7D2B7" }
    },
    {
      "id": "mist-story",
      "label": "航·雾紫叙事",
      "description": "灰紫、雾面纸张与叙事型柔和强调。",
      "tokens": { "accent": "#7657B7", "warm": "#D88B68", "ink": "#201A2B", "body": "#463D55", "paper": "#F7F2FA", "pale": "#F0EAF7", "border": "#D8CDE4" }
    }
  ],
  "typography": {
    "fonts": [
      { "id": "theme", "label": "跟随主题", "value": "inherit" },
      { "id": "system-sans", "label": "系统无衬线", "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif" },
      { "id": "pingfang", "label": "苹方优先", "value": "'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif" },
      { "id": "yahei", "label": "微软雅黑优先", "value": "'Microsoft YaHei', 'PingFang SC', sans-serif" },
      { "id": "serif", "label": "系统宋体 / 衬线", "value": "'Songti SC', SimSun, Georgia, serif" },
      { "id": "kai", "label": "系统楷体", "value": "KaiTi, 'STKaiti', serif" }
    ],
    "targets": ["h1", "h2", "h3", "h4", "h5", "h6", "body", "quote", "strong"],
    "size": { "min": 10, "max": 40, "step": 1 },
    "weights": [100, 200, 300, 400, 500, 600, 700, 800, 900]
  },
  "spacing": [
    { "id": "paragraph", "label": "段落间距", "min": 8, "max": 42, "step": 1, "value": 20 },
    { "id": "heading-top", "label": "标题上间距", "min": 16, "max": 80, "step": 1, "value": 48 },
    { "id": "heading-bottom", "label": "标题下间距", "min": 8, "max": 48, "step": 1, "value": 22 },
    { "id": "image-top", "label": "图片上间距", "min": 0, "max": 56, "step": 1, "value": 28 },
    { "id": "image-bottom", "label": "图片下间距", "min": 0, "max": 56, "step": 1, "value": 10 }
  ],
  "components": [
    {
      "id": "h1",
      "label": "一级标题 H1",
      "sample": "一篇文章的主标题",
      "options": [
        { "id": "issue-cover", "label": "刊头双线", "marker": "ISSUE 01", "style": "padding:20px 0 16px;border-top:4px double var(--accent);border-bottom:1px solid var(--accent);font-size:28px;font-weight:800;color:var(--ink);", "accentStyle": "display:block;margin-bottom:10px;color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.22em;" },
        { "id": "center-axis", "label": "居中细线", "marker": "ARTICLE", "style": "padding:18px 20px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);text-align:center;font-size:27px;font-weight:760;color:var(--ink);", "accentStyle": "display:block;margin-bottom:8px;color:var(--accent);font-size:10px;letter-spacing:.28em;" }
      ]
    },
    {
      "id": "h2",
      "label": "二级标题 H2",
      "sample": "先把问题讲清楚",
      "options": [
        { "id": "index-rule", "label": "编号底线", "marker": "01", "style": "padding:0 0 12px;border-bottom:1px solid var(--border);font-size:22px;font-weight:760;color:var(--ink);", "accentStyle": "display:inline-block;margin-right:10px;padding:2px 7px;background:var(--accent);color:#fff;font-size:11px;vertical-align:middle;" },
        { "id": "center-section", "label": "居中栏目", "marker": "TOPIC", "style": "padding:13px 0;text-align:center;border-top:1px solid var(--border);border-bottom:1px solid var(--border);font-size:21px;font-weight:760;color:var(--ink);", "accentStyle": "display:block;margin-bottom:5px;color:var(--accent);font-size:9px;letter-spacing:.3em;" }
      ]
    },
    {
      "id": "h3",
      "label": "三级标题 H3",
      "sample": "一个局部判断",
      "options": [
        { "id": "marker-stroke", "label": "荧光底线", "marker": "", "style": "display:table;padding:0 3px 2px;background:linear-gradient(transparent 62%,var(--pale) 62%);font-size:19px;font-weight:760;color:var(--ink);", "accentStyle": "display:none;" }
      ]
    },
    {
      "id": "quote",
      "label": "引用块",
      "sample": "真正值得保留的，不是装饰，而是阅读节奏。",
      "options": [
        { "id": "centered-quote", "label": "居中金句", "style": "padding:22px 18px;border-top:1px solid var(--accent);border-bottom:1px solid var(--accent);text-align:center;font-family:'Songti SC',SimSun,serif;font-size:18px;line-height:1.8;color:var(--ink);" },
        { "id": "serif-pull", "label": "衬线大引语", "style": "padding:18px 10px;font-family:'Songti SC',SimSun,serif;font-size:20px;line-height:1.8;color:var(--ink);text-align:center;" }
      ]
    },
    {
      "id": "strong",
      "label": "重点标签",
      "sample": "关键判断",
      "options": [
        { "id": "accent", "label": "主色强调", "style": "font-weight:760;color:var(--accent);" }
      ]
    },
    {
      "id": "ordered-list",
      "label": "有序列表",
      "sample": "把目标和边界讲清楚",
      "options": [
        { "id": "leading-zero", "label": "双位编号", "marker": "01", "style": "padding:8px 0;border-bottom:1px solid var(--border);color:var(--body);", "accentStyle": "display:inline-block;margin-right:10px;color:var(--accent);font-weight:800;letter-spacing:.06em;" }
      ]
    },
    {
      "id": "unordered-list",
      "label": "无序列表",
      "sample": "正文适合手机阅读",
      "options": [
        { "id": "soft-check", "label": "圆角对勾", "marker": "✓", "style": "padding:8px 0;color:var(--body);", "accentStyle": "display:inline-grid;width:23px;height:23px;margin-right:10px;border-radius:7px;background:var(--pale);place-items:center;color:var(--accent);font-weight:800;" }
      ]
    },
    {
      "id": "table",
      "label": "表格",
      "sample": "元素|作用",
      "options": [
        { "id": "minimal-lines", "label": "极简横线", "style": "width:100%;border-collapse:collapse;border-top:2px solid var(--accent);border-bottom:2px solid var(--accent);color:var(--body);", "accentStyle": "padding:8px 10px;border-bottom:1px solid var(--accent);color:var(--ink);text-align:left;" }
      ]
    }
  ],
  "imageStyles": [
    { "id": "theme", "label": "跟随主题", "style": "display:block;width:100%;height:auto;" }
  ]
}
